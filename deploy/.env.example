# Domain Tessery is served on. Point its DNS at this machine before starting; Caddy gets the certificate.
TESSERY_DOMAIN=tessery.example.com

# Image version to run. "latest" follows new releases; a version such as 0.2.0 pins it.
TESSERY_IMAGE_TAG=latest

# Encrypts environment secrets, git credentials, server keys and provider credentials. Generate with
# `openssl rand -hex 32`. To change it, follow "Rotating the secret key" in the README.
TESSERY_SECRET_KEY=

# Only while rotating: the old key, used to read values until `tessery-server rotate-key` has moved them.
TESSERY_SECRET_KEY_PREVIOUS=

# Passwords for the bundled Postgres and RabbitMQ, and the key for the bundled SeaweedFS object storage that
# keeps uploaded images and fonts. Use letters and digits only.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
TESSERY_S3_SECRET_KEY=

# Group id that owns /var/run/docker.sock, from `stat -c %g /var/run/docker.sock`.
DOCKER_GID=

# Folder holding this file and compose.yml. Lets admins update from the app. Leave empty to turn that off.
TESSERY_COMPOSE_DIR=/opt/tessery

# Host ports for Caddy. Change them only when something else already uses 80 or 443.
TESSERY_HTTP_PORT=80
TESSERY_HTTPS_PORT=443

RUST_LOG=info
