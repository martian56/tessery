{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (r.project_id, r.env_key) r.id, r.project_id, r.env_key, r.status::text AS \"status!\", c.seq AS checkpoint_seq, r.requested_at, r.error\n           FROM releases r JOIN checkpoints c ON c.id = r.checkpoint_id JOIN projects p ON p.id = r.project_id\n           WHERE p.org_id = $1\n           ORDER BY r.project_id, r.env_key, r.requested_at DESC",
