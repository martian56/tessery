  "db_name": "PostgreSQL",
  "query": "UPDATE api_tokens SET last_used_at = CASE WHEN last_used_at IS NULL OR last_used_at < now() - interval '1 minute' THEN now() ELSE last_used_at END\n           WHERE hash = $1 AND revoked_at IS NULL AND (expires_at IS NULL OR expires_at > now())\n           RETURNING id, user_id, name, prefix, permissions, project_id, expires_at, last_used_at, created_at",
